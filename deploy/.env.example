# 复制为 .env（chmod 600），真值只留在服务器上，不提交。
BASE_URL=https://stats.ganjiday.com
# openssl rand -base64 48
SECRET_KEY_BASE=
# openssl rand -hex 24
POSTGRES_PASSWORD=
# 首个账号注册后保持 invite_only：只能由管理员邀请
DISABLE_REGISTRATION=invite_only
# 以下可选项保持注释：空值会以空字符串传给容器，部分变量（如 SMTP_HOST_PORT）为空会导致启动失败
# 可选：MaxMind GeoLite2 免费 key，填写后支持城市级地区；不填用内置 db-ip 国家库
# MAXMIND_LICENSE_KEY=
# 可选：SMTP 中继（阿里云默认封出站 25 端口，未配置时不能发邀请和找回密码邮件）
# 当前用 Resend SMTP：发件域 mail.ganjiday.com 已在 Resend 验证；密码为仅限该域发送权限的 API key
# SMTP_HOST_ADDR=smtp.resend.com
# SMTP_HOST_PORT=465
# SMTP_HOST_SSL_ENABLED=true
# SMTP_USER_NAME=resend
# SMTP_USER_PWD=
# MAILER_EMAIL=plausible@mail.ganjiday.com
# MAILER_NAME=Plausible
# 可选：R2 异地备份，只由 backup.sh 读取，不传进容器；token 权限为 Object Read & Write，且只限这个 bucket
# R2_ACCOUNT_ID=
# R2_BUCKET=plausible-backups
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
