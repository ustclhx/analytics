# 复制为 .env（chmod 600），真值只留在服务器上，不提交。
BASE_URL=https://stats.ganjiday.com
# openssl rand -base64 48
SECRET_KEY_BASE=
# openssl rand -hex 24
POSTGRES_PASSWORD=
# 首个账号注册后保持 invite_only：只能由管理员邀请
DISABLE_REGISTRATION=invite_only
# 以下可选项保持注释：空值会以空字符串传给容器，部分变量（如 SMTP_HOST_PORT）为空会导致启动失败
# 可选：MaxMind GeoLite2 免费 key，填写后支持城市级地区；不填用内置 db-ip 国家库
# MAXMIND_LICENSE_KEY=
# 可选：SMTP 中继（阿里云默认封出站 25 端口，未配置时不能发邀请和找回密码邮件）
# SMTP_HOST_ADDR=
# SMTP_HOST_PORT=
# SMTP_USER_NAME=
# SMTP_USER_PWD=
# SMTP_HOST_SSL_ENABLED=
# MAILER_EMAIL=
